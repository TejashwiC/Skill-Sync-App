<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test History"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Section 1: Created Test History & Attendees -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Created Test History &amp; Attendees"
            android:textColor="#1565C0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvEmptyCreatedHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tests created by you yet."
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/llCreatedTestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <!-- Section 2: Attended Test History -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Attended Test History"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvEmptyAttendedHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tests attended by you yet."
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/llAttendedTestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
