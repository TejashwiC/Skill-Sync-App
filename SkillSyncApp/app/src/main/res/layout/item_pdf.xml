<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPdfName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1A1A2E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPdfUploader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- View Button (Blue, matching web style) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewPdf"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="👁 View"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"
                app:cornerRadius="8dp" />

            <!-- Download Button (Green, matching web style) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadPdf"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="📥 Download"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"
                app:cornerRadius="8dp" />

            <!-- Delete Button (Red, shown only for owner) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeletePdf"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="🗑 Delete"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
